<?xml version="1.0" encoding="UTF-8"?>
<beans>
	<bean id="bbs" class="com.lppnb.test.service.BaseBaseService" init-method="init">
		<property type="com.lppnb.test.service.AServiceImpl" name="as" ref="aservice"/>
	</bean>
	<bean id="aservice" class="com.lppnb.test.service.AServiceImpl">
		<constructor-arg type="String" name="name" value="abc"/>
		<constructor-arg type="int" name="level" value="3"/>
		<property type="String" name="property1" value="Someone says"/>
		<property type="String" name="property2" value="Hello World!"/>
		<property type="com.lppnb.test.service.BaseService" name="ref1" ref="baseservice"/>
	</bean>
	<bean id="baseservice" class="com.lppnb.test.service.BaseService" />

	<bean id="contextListener" class="com.lppnb.test.MyListener" />

	<bean id="beanFactoryPostProcessor" class="com.lppnb.test.MyBeanFactoryPostProcessor" />

	<bean id="autowiredAnnotationBeanPostProcessor" class="com.lppnb.minis.beans.factory.annotation.AutowiredAnnotationBeanPostProcessor" />
	<bean id="logBeanPostProcessor" class="com.lppnb.test.LogBeanPostProcessor" />


	<bean id="handlerMapping" class="com.lppnb.minis.web.method.annotation.RequestMappingHandlerMapping"/>

	<bean id="handlerAdapter" class="com.lppnb.minis.web.method.annotation.RequestMappingHandlerAdapter">
		<property type="com.lppnb.minis.http.converter.HttpMessageConverter" name="messageConverter" ref="messageConverter"/>
		<property type="com.lppnb.minis.web.bind.support.WebBindingInitializer" name="webBindingInitializer" ref="webBindingInitializer"/>
	</bean>

	<bean id="webBindingInitializer" class="com.lppnb.test.DateInitializer" />

	<bean id="messageConverter" class="com.lppnb.minis.http.converter.DefaultHttpMessageConverter">
		<property type="com.lppnb.minis.util.ObjectMapper" name="objectMapper" ref="objectMapper"/>
	</bean>
	<bean id="objectMapper" class="com.lppnb.minis.util.DefaultObjectMapper" >
		<property type="String" name="dateFormat" value="yyyy/MM/dd"/>
		<property type="String" name="decimalFormat" value="###.##"/>
	</bean>>

	<bean id="viewResolver" class="com.lppnb.minis.web.servlet.view.InternalResourceViewResolver" >
		<property type="String" name="viewClassName" value="com.lppnb.minis.web.servlet.view.JstlView" />
		<property type="String" name="prefix" value="/jsp/" />
		<property type="String" name="suffix" value=".jsp" />
	</bean>




</beans>