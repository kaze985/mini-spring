<?xml version="1.0" encoding="UTF-8"?>
<beans>
    <bean id="bbs" class="com.lppnb.minis.test.BaseBaseService" init-method="init">
        <property type="com.lppnb.minis.test.AServiceImpl" name="as" ref="aservice"/>
    </bean>
    <bean id="aservice" class="com.lppnb.minis.test.AServiceImpl">
        <constructor-arg type="String" name="name" value="abc"/>
        <constructor-arg type="int" name="level" value="3"/>
        <property type="String" name="property1" value="Someone says"/>
        <property type="String" name="property2" value="Hello World!"/>
        <property type="com.lppnb.minis.test.BaseService" name="ref1" ref="baseservice"/>
    </bean>
    <bean id="baseservice" class="com.lppnb.minis.test.BaseService"/>

    <!--	<bean id="contextListener" class="com.lppnb.test.MyListener" />-->

    <!--	<bean id="beanFactoryPostProcessor" class="com.lppnb.test.MyBeanFactoryPostProcessor" />-->

    <bean id="autowiredAnnotationBeanPostProcessor"
          class="com.lppnb.minis.beans.factory.annotation.AutowiredAnnotationBeanPostProcessor"/>
    <!--	<bean id="logBeanPostProcessor" class="com.lppnb.test.LogBeanPostProcessor" />-->


    <bean id="handlerMapping" class="com.lppnb.minis.web.method.annotation.RequestMappingHandlerMapping"/>

    <bean id="handlerAdapter" class="com.lppnb.minis.web.method.annotation.RequestMappingHandlerAdapter">
        <property type="com.lppnb.minis.http.converter.HttpMessageConverter" name="messageConverter"
                  ref="messageConverter"/>
        <property type="com.lppnb.minis.web.bind.support.WebBindingInitializer" name="webBindingInitializer"
                  ref="webBindingInitializer"/>
    </bean>

    <bean id="webBindingInitializer" class="com.lppnb.minis.test.DateInitializer"/>

    <bean id="messageConverter" class="com.lppnb.minis.http.converter.DefaultHttpMessageConverter">
        <property type="com.lppnb.minis.util.ObjectMapper" name="objectMapper" ref="objectMapper"/>
    </bean>
    <bean id="objectMapper" class="com.lppnb.minis.util.DefaultObjectMapper">
        <property type="String" name="dateFormat" value="yyyy/MM/dd"/>
        <property type="String" name="decimalFormat" value="###.##"/>
    </bean>
    

    <bean id="viewResolver" class="com.lppnb.minis.web.servlet.view.InternalResourceViewResolver">
        <property type="String" name="viewClassName" value="com.lppnb.minis.web.servlet.view.JstlView"/>
        <property type="String" name="prefix" value="/jsp/"/>
        <property type="String" name="suffix" value=".jsp"/>
    </bean>


    <bean id="dataSource" class="com.lppnb.minis.jdbc.pool.PooledDataSource">
        <property name="url" value="jdbc:sqlserver://localhost:1433;databasename=DEMO"/>
        <property name="driverClassName" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
        <property name="username" value="sa"/>
        <property name="password" value="Sql2016"/>
        <property type="int" name="initialSize" value="3"/>
    </bean>


    <bean id="jdbcTemplate" class="com.lppnb.minis.jdbc.core.JdbcTemplate">
        <property type="javax.sql.DataSource" name="dataSource" ref="dataSource"/>
    </bean>


</beans>