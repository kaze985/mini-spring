        <property type="String" name="interceptorName" value="myInterceptor"/>	
	</bean>  -->
	
	<bean id="action" class="com.lppnb.minis.test.service.Action1" />
	<bean id="action2" class="com.lppnb.minis.test.service.Action2" />
	
	<bean id="beforeAdvice" class="com.lppnb.minis.test.service.MyBeforeAdvice" />
	<bean id="advisor" class="com.lppnb.minis.aop.NameMatchMethodPointcutAdvisor">
        <property type="com.lppnb.minis.aop.Advice" name="advice" ref="beforeAdvice"/>
        <property type="String" name="mappedName" value="do*"/>
    </bean>
    
	    
    
